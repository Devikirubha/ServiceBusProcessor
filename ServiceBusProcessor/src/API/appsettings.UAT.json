{
  "ConnectionStrings": {
    "DefaultConnection": "Server=uat-sql-server;Database=ServiceBusProcessorUAT;User Id=app_user;Password=#{UAT_DB_PASSWORD}#;TrustServerCertificate=True"
  },
  "AzureServiceBus": {
    "ConnectionString": "#{UAT_SERVICEBUS_CONNECTION}#",
    "QueueName": "messages-uat"
  },
  "JwtSettings": {
    "SecretKey": "#{UAT_JWT_SECRET}#",
    "Issuer": "ServiceBusProcessor-UAT",
    "Audience": "ServiceBusProcessor-Clients-UAT",
    "ExpiryMinutes": 30
  },
  "AllowHttp": false,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/servicebus-processor/uat-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
