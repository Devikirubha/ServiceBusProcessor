{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ServiceBusProcessorDev;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "AzureServiceBus": {
    "ConnectionString": "Endpoint=sb://YOUR-DEV-NAMESPACE.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=YOUR_KEY",
    "QueueName": "messages-dev"
  },
  "JwtSettings": {
    "SecretKey": "DEV-super-secret-key-at-least-32-characters-long!",
    "Issuer": "ServiceBusProcessor-Dev",
    "Audience": "ServiceBusProcessor-Clients-Dev",
    "ExpiryMinutes": 60
  },
  "AllowHttp": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dev-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
      ,
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionStringName": "DefaultConnection",
          "tableName": "Logs",
          "autoCreateSqlTable": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
