{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AzureServiceBus": {
    "ConnectionString": "",
    "QueueName": "messages-dev"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "ServiceBusProcessor-Dev",
    "Audience": "ServiceBusProcessor-Clients-Dev",
    "ExpiryMinutes": 60
  },
  "KeyVault": {
    "VaultUri": "#{KEYVAULT_URI}#"
  },
  "AllowHttp": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dev-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
      ,
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionStringName": "DefaultConnection",
          "tableName": "Logs",
          "autoCreateSqlTable": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
