{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tst-sql-server;Database=ServiceBusProcessorTST;User Id=app_user;Password=#{TST_DB_PASSWORD}#;TrustServerCertificate=True"
  },
  "AzureServiceBus": {
    "ConnectionString": "#{TST_SERVICEBUS_CONNECTION}#",
    "QueueName": "messages-tst"
  },
  "JwtSettings": {
    "SecretKey": "#{TST_JWT_SECRET}#",
    "Issuer": "ServiceBusProcessor-TST",
    "Audience": "ServiceBusProcessor-Clients-TST",
    "ExpiryMinutes": 60
  },
  "AllowHttp": false,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/servicebus-processor/tst-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
